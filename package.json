{
  "name": "cypress.framework.ui.and.api",
  "version": "1.0.0",
  "description": "Accelerator for implementing cypress for user interface test automation",
  "main": "index.js",
  "scripts": {
    "test": "npx cypress open",
    "cy:run:prod": "npx cypress run --env configFile=prod ",
    "cy:open:prod": "npx cypress open --env configFile=prod --browser=chrome --e2e",
    "cy:run:hml": "npx cypress run --env configFile=hml",
    "cy:open:hml": "npx cypress open --env configFile=hml --browser=chrome --e2e",
    "clear-reports": "node ./cypress/support/clear-reports.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeoKartabil/cypress.framework.ui.and.api.git"
  },
  "keywords": [
    "cypress",
    "test",
    "automation",
    "ui",
    "api"
  ],
  "author": "Leonardo Kartabil (leonardo.kartabil@compasso.com.br)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/LeoKartabil/cypress.framework.ui.and.api/issues"
  },
  "homepage": "https://github.com/LeoKartabil/cypress.framework.ui.and.api#readme",
  "devDependencies": {
    "@faker-js/faker": "^10.1.0",
    "ajv": "^8.17.1",
    "cypress": "^15.4.0",
    "cypress-fixture-faker": "^1.0.4",
    "cypress-mochawesome-reporter": "^4.0.2",
    "cypress-plugin-api": "^2.11.2",
    "cypress-plugin-xhr-toggle": "^1.2.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.0.0",
    "mochawesome-report-generator": "^6.3.0"
  }
}
